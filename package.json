{
  "name": "synapse",
  "version": "0.28.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/device-protocol",
    "packages/device-runtime",
    "packages/device-runtime-bundles-linux-x64",
    "packages/device-runtime-bundles-linux-arm64",
    "packages/device-runtime-bundles-darwin-x64",
    "packages/device-runtime-bundles-darwin-arm64",
    "packages/device-runtime-bundles-win32-x64",
    "packages/device-runtime-bundles-win32-arm64",
    "packages/device-sdk",
    "packages/api",
    "packages/remote-agent-daemon",
    "packages/web-next",
    "packages/web-next-design"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-patches.mjs",
    "dev:api": "npm run dev -w packages/api",
    "dev:daemon": "npm run dev -w packages/remote-agent-daemon",
    "dev:web": "npm run dev -w packages/web-next",
    "dev:web-design": "npm run dev -w packages/web-next-design",
    "dev:mock-chat": "node .workbuddy/mock-chat-completions-server.cjs",
    "prepare": "git config core.hooksPath .githooks",
    "format": "node scripts/format-files.mjs --all",
    "format:check": "node scripts/format-files.mjs --all --check",
    "format:staged": "lint-staged",
    "build:cua-helper": "bash scripts/build-cua-helper.sh",
    "build:fs-helper": "bash scripts/build-fs-helper.sh",
    "verify:fs-helper": "bash scripts/verify-fs-helper.sh",
    "build": "npm run build:cua-helper && npm run build:fs-helper && npm run build -w packages/device-protocol && npm run build -w packages/shared && npm run build:chat-worker && npm run build -w packages/device-runtime && npm run build -w packages/device-sdk && npm run build -w packages/api && npm run build -w packages/remote-agent-daemon && npm run build -w packages/web-next",
    "build:shared": "npm run build -w packages/shared",
    "build:chat-worker": "npm run build:chat-worker -w packages/web-next && npm --prefix packages/mobile-app run build:chat-worker",
    "build:device-protocol": "npm run build -w packages/device-protocol",
    "build:device-runtime": "npm run build -w packages/device-runtime",
    "build:device-sdk": "npm run build -w packages/device-sdk",
    "build:api": "npm run build -w packages/api",
    "build:daemon": "npm run build -w packages/remote-agent-daemon",
    "build:web": "npm run build -w packages/device-protocol && npm run build -w packages/shared && npm run build -w packages/web-next",
    "typecheck:api": "npm run typecheck -w packages/api",
    "typecheck": "npm run typecheck:api",
    "test": "npm run test -w packages/api",
    "test:api": "npm run test -w packages/api",
    "test:web": "npm run test -w packages/web-next",
    "test:conformance": "npm run test:conformance -w packages/api",
    "guard:datetime": "node scripts/guard-datetime-boundaries.mjs",
    "guard:logging": "node scripts/guard-logging.mjs",
    "guard:versions": "node scripts/guard-workspace-versions.mjs",
    "schema:gen": "npm run build:device-protocol && npm run build:shared && npm run build:device-runtime && npm run schema:gen -w packages/api",
    "guard:schemas": "npm run build:device-protocol && npm run build:shared && npm run build:device-runtime && npm run guard:schemas -w packages/api",
    "schema:refresh-vendored": "node scripts/refresh-vendored-schemas.mjs",
    "audit:business-enums": "node ./scripts/audit-business-enum-literals.mjs",
    "verify:boundary": "bash ./scripts/verify-boundary.sh",
    "audit:device-runtime-sidecars": "tsx ./scripts/audit-device-runtime-sidecars.mts",
    "installer:gen-node-manifest": "node ./scripts/installer/generate-node-manifest.mjs",
    "verify:installer": "bash ./scripts/installer/install.test.sh",
    "lint:deps": "syncpack lint --dependencies 'zod'",
    "lint:deps:fix": "syncpack fix --dependencies 'zod'",
    "db:bootstrap": "npm run db:bootstrap -w packages/api",
    "db:codegen": "npm run db:codegen -w packages/api",
    "db:seed": "npm run db:seed -w packages/api",
    "db:seed:model-groups": "npm run db:seed:model-groups -w packages/api",
    "db:rebuild": "npm run db:rebuild -w packages/api",
    "lint": "npm run lint -w @synapse/shared -w @synapse/device-protocol -w @synapse/device-sdk -w @synapse/device-runtime -w @synapse/api -w @synapse/remote-agent-daemon",
    "lint:fix": "npm run lint:fix -w @synapse/shared -w @synapse/device-protocol -w @synapse/device-sdk -w @synapse/device-runtime -w @synapse/api -w @synapse/remote-agent-daemon"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@better-auth/core": "1.7.7",
    "idb-keyval": "6.2.4",
    "@modelcontextprotocol/sdk@^1.29.0": {
      "zod": "4.3.6"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.0.5",
    "syncpack": "15.3.1",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,json,css,md,mdx,yml,yaml,html}": "node scripts/format-files.mjs --formatter=prettier"
  }
}

{
  "name": "@synapse/api",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-installer-assets.mjs",
    "pretypecheck": "npm run build -w @synapse/device-protocol -w @synapse/shared -w @synapse/device-runtime",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "guard:db": "node scripts/guard-db-paradigm.mjs",
    "guard:fk-policy": "node scripts/derive-fk-policy.mjs --check",
    "guard:soft-delete": "node scripts/guard-soft-delete.mjs",
    "guard:layering": "node scripts/guard-layering.mjs",
    "guard:content-store": "node scripts/guard-content-store.mjs",
    "guard:logging": "node ../../scripts/guard-logging.mjs",
    "gen:fk-policy": "node scripts/derive-fk-policy.mjs",
    "schema:gen": "tsx scripts/gen-config-schemas.mts",
    "guard:schemas": "tsx scripts/gen-config-schemas.mts --check",
    "pretest": "bash ../../scripts/pretest-fs-helper.sh release && npm run guard:db && npm run guard:fk-policy && npm run guard:soft-delete && npm run guard:layering && npm run guard:content-store && node ../../scripts/guard-datetime-boundaries.mjs --self-test && node ../../scripts/guard-datetime-boundaries.mjs && node ../../scripts/guard-logging.mjs && npm run typecheck && npm run guard:schemas",
    "test": "tsx --test --experimental-test-module-mocks --test-concurrency=4 \"src/**/*.test.ts\"",
    "test:integration": "bash tests/integration/scripts/run-integration.sh",
    "test:integration:keep-stack": "KEEP_CONTAINERS=1 bash tests/integration/scripts/run-integration.sh",
    "test:integration:llm-smoke": "tsx --test tests/integration/manual/llm-smoke.test.ts",
    "test:conformance": "tsx --test \"src/modules/runtime-authorizations/conformance.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/modules/access/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" \"src/modules/access/*.test.ts\" \"src/test/helpers/db.test.ts\"",
    "db:bootstrap": "tsx src/infrastructure/database/bootstrap.ts && npm run db:codegen",
    "db:bootstrap:runtime": "tsx src/infrastructure/database/bootstrap.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:seed:builtin-mcp": "tsx src/infrastructure/database/seed-builtin-mcp-plugins.ts",
    "db:seed:model-groups": "tsx src/infrastructure/database/seed-model-groups/cli.ts",
    "db:rebuild": "tsx src/infrastructure/database/rebuild.ts && npm run db:codegen",
    "db:rebuild:runtime": "tsx src/infrastructure/database/rebuild.ts",
    "db:codegen": "node scripts/db-codegen.mjs",
    "db:codegen:verify": "npm run db:codegen -- --verify",
    "db:purge:retention": "tsx src/infrastructure/database/purge.ts retention",
    "db:purge:workspace": "tsx src/infrastructure/database/purge.ts workspace",
    "gen:cutover-ddl": "node scripts/cutover-emit-ddl.mjs",
    "gen:purge-ddl": "node scripts/cutover-emit-purge.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "lint:types": "NODE_OPTIONS=--max-old-space-size=8192 eslint --no-config-lookup -c eslint.config.types.mjs src tests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.0",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-ioredis": "0.67.0",
    "@opentelemetry/instrumentation-pg": "0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@secretlint/core": "^13.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@sentry/node": "^10.58.0",
    "@sentry/opentelemetry": "^10.58.0",
    "@synapse/device-protocol": "0.28.0",
    "@synapse/device-runtime": "0.28.0",
    "@synapse/shared": "0.28.0",
    "@wecom/aibot-node-sdk": "1.0.6",
    "ai": "^6.0.197",
    "baileys": "6.7.23",
    "better-auth": "1.7.7",
    "bullmq": "^5.8.0",
    "cron-parser": "^4.9.0",
    "diff": "^9.0.0",
    "dingtalk-stream": "^2.1.5",
    "dlv": "^1.1.3",
    "dotenv": "^16.4.0",
    "eventsource-parser": "^3.0.6",
    "fast-deep-equal": "^3.1.3",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.1",
    "intl-messageformat": "^11.0.0",
    "ioredis": "^5.4.0",
    "ipaddr.js": "^1.9.1",
    "js-yaml": "^4.1.0",
    "kysely": "^0.28.17",
    "lru-cache": "^10.4.3",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "undici": "^5.29.0",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.0",
    "ws": "^8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.0",
    "@types/dlv": "^1.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "kysely-codegen": "^0.20.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}

{
  "name": "@synapse/mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "build:chat-worker": "node ./scripts/build-chat-worker.mjs",
    "sync:shared": "npm --prefix ../.. run build -w @synapse/device-protocol && npx tsc -p ../shared/tsconfig.json",
    "prestart": "npm run sync:shared",
    "prestart:clear": "npm run sync:shared",
    "preandroid": "npm run sync:shared",
    "preios": "npm run sync:shared",
    "preweb": "npm run sync:shared && npm run build:chat-worker",
    "pretypecheck": "npm run sync:shared",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "npm run sync:shared && npm run build:chat-worker && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "eslint app src",
    "lint:fix": "eslint app src --fix"
  },
  "dependencies": {
    "@better-auth/core": "1.6.13",
    "@better-auth/expo": "1.6.13",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.13.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.100.14",
    "@vscode/markdown-it-katex": "^1.1.2",
    "better-auth": "1.6.13",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-background-task": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "idb": "^8.0.3",
    "katex": "^0.16.44",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.14.0",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-pager-view": "^6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "twemoji": "^14.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "~19.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@better-auth/core": "1.6.13"
  },
  "private": true
}

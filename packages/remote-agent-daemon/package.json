{
  "name": "@synapse/remote-agent-daemon",
  "version": "0.28.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "synapse-remote-agent-daemon": "./dist/index.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "prebuild": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.148",
    "@anthropic-ai/sdk": "0.100.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "typebox": "1.3.27",
    "ws": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@synapse/device-protocol": "0.28.0",
    "@types/node": "^25.1.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}

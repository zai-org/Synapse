{
  "name": "web-next-design",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build:chat-worker": "node ./scripts/build-chat-service-worker.mjs",
    "build:repo-link": "node ./scripts/build-repo-link-static.mjs",
    "dev": "next dev --port 3100",
    "build": "next build --webpack",
    "fetch-twemoji": "node scripts/fetch-twemoji.mjs",
    "predev": "node scripts/fetch-twemoji.mjs && npm run build:chat-worker",
    "prebuild": "npm --workspace=@synapse/shared run build && npm run build:chat-worker",
    "start": "next start --port 3100",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "pretest": "npm --workspace=@synapse/shared run build",
    "test": "vitest run",
    "pretypecheck": "npm --workspace=@synapse/shared run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",

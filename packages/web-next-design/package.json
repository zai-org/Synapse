    "@emoji-mart/data": "^1.2.1",
    "@faker-js/faker": "^10.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@sentry/nextjs": "^10.58.0",
    "@synapse/shared": "file:../shared",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-mention": "^3.20.6",
    "@tiptap/extension-placeholder": "^3.20.6",
    "@tiptap/react": "^3.20.6",
    "@tiptap/starter-kit": "^3.20.6",
    "@tiptap/suggestion": "^3.20.6",
    "@wavesurfer/react": "^1.0.12",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.1",
    "cronstrue": "^3.24.0",
    "docx-preview": "^0.3.7",
    "embla-carousel-react": "^8.6.0",
    "emojibase-data": "^17.0.0",
    "framer-motion": "^12.36.0",
    "frimousse": "^0.3.0",
    "idb": "^8.0.3",
    "is-mobile": "^5.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.77.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "twemoji": "^14.0.2",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.12.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "4.3.6",
    "zod-schema-faker": "^2.1.1",
    "zustand": "^4.5.5"
  },
